# ============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# IMPORTANT: 
# 1. Copy this file as .env and fill in your actual values
# 2. .env is in .gitignore - NEVER commit secrets to version control
# 3. In production, use secure secret management:
#    - AWS Secrets Manager
#    - GitHub Secrets (for CI/CD)
#    - HashiCorp Vault
#    - Azure Key Vault
#    - Your hosting platform's secret management
# ============================================================================

# ============================================================================
# SERVER ENVIRONMENT
# ============================================================================
NODE_ENV=development
# For production deployments: NODE_ENV=production
# This affects logging verbosity, error messages, and security headers

PORT=5000
# Port the server listens on. Use environment-specific values:
# - Development: 5000
# - Production: Usually 5000 (then reverse proxy on 80/443)

# ============================================================================
# CORS & FRONTEND URL
# ============================================================================
# CRITICAL: This MUST match your frontend domain exactly (no trailing slash)
# Development:
FRONTEND_URL=http://localhost:5173

# Production examples (choose one):
# FRONTEND_URL=https://yourdomain.com
# FRONTEND_URL=https://app.yourdomain.com
# FRONTEND_URL=https://quran.yourdomain.com

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# LOCAL DEVELOPMENT (MongoDB running locally):
# MONGODB_URI=mongodb://localhost:27017/quran

# MONGODB ATLAS (Cloud-hosted - Recommended for production):
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# 
# Steps to create MongoDB Atlas connection:
# 1. Go to https://www.mongodb.com/cloud/atlas
# 2. Create a cluster
# 3. Create a database user (NOT admin account)
# 4. Add your IP to the IP Whitelist
# 5. Click "Connect" → "Drivers" → Copy connection string
# 6. Replace <username>, <password>, and <database> with your values
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/quran?retryWrites=true&w=majority

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# JWT Secret Key for signing authentication tokens
# 
# SECURITY REQUIREMENTS:
# - Minimum 32 characters
# - Randomly generated (use cryptographically secure methods)
# - Never use weak strings like "secret" or "password"
# 
# Generate a strong secret with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-strong-random-secret-key-32-chars-minimum

# JWT Token Expiration Time (optional)
# Format: number + unit (s, m, h, d, y)
JWT_EXPIRATION=7d

# ============================================================================
# TWILIO CONFIGURATION (Optional - for SMS notifications)
# ============================================================================
# Leave these blank/commented if not using Twilio
# To get credentials: https://www.twilio.com/console
# 
# Account SID: Found in Twilio Dashboard
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auth Token: Found in Twilio Dashboard (keep secret!)
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your Twilio phone number (verified sender)
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================================
# TELEGRAM CONFIGURATION (Optional - for bot notifications)
# ============================================================================
# Leave these blank/commented if not using Telegram
# Create a bot: https://t.me/botfather
# 
# Bot token from BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklmnoPQRstuvWXYzabcdefghij

# Your chat/channel ID (get from @userinfobot)
TELEGRAM_CHAT_ID=123456789

# ============================================================================
# LOGGING & DEBUG (Optional)
# ============================================================================
# Enable detailed request logging
DEBUG=false
# Set to true only in development for debugging

# ============================================================================
# SECURITY HEADERS (Configured in src/app.js)
# ============================================================================
# These settings are preconfigured but can be adjusted:
# - HSTS: 1 year (31536000 seconds) HTTPS enforcement
# - CSP: Content Security Policy headers
# - Rate limiting: 100 requests per 15 minutes (general), 5 per 15 min (auth)
# 
# Review PRODUCTION_DEPLOYMENT_GUIDE.md for customization details

# ============================================================================
# PRODUCTION DEPLOYMENT NOTES
# ============================================================================
# Before deploying to production:
# 
# 1. ✅ Set NODE_ENV=production
# 2. ✅ Update FRONTEND_URL to your production domain
# 3. ✅ Generate a new strong JWT_SECRET
# 4. ✅ Create a dedicated MongoDB user (not admin)
# 5. ✅ Enable IP whitelist in MongoDB Atlas
# 6. ✅ Configure HTTPS/TLS certificate
# 7. ✅ Set up reverse proxy (nginx recommended)
# 8. ✅ Verify all secrets are in your deployment platform
# 9. ✅ Test CORS with production domain
# 10. ✅ Load test with 300+ concurrent users
# 
# See PRODUCTION_DEPLOYMENT_GUIDE.md for detailed instructions
